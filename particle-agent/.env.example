GEMINI_API_KEY=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_ID=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
GOOGLE_CALENDAR_CREDENTIALS=
APP_ENVIRONMENT=development

# Hugging Face (Voxtral STT — free)
HF_TOKEN=your_huggingface_token_here

# ElevenLabs (voice cloning TTS — free tier)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here

# Google account used by the meeting bot when its saved cookies expire (keep it here, never in config.yaml)
GOOGLE_MEET_EMAIL=
GOOGLE_MEET_PASSWORD=

# Set to 1 on servers: the meeting bot needs a visible Chrome window and audio devices
PARTICLE_DISABLE_MEETING_BOT=
